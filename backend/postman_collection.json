{
  "info": {
    "_postman_id": "portfolio-api-v1",
    "name": "Portfolio API - Wandile Nene",
    "description": "Complete REST API collection for the Portfolio backend. Covers all CRUD operations for Profile, Education, Experience, Skills, Certifications, Projects, Achievements, Contact, and the Summary endpoint.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000", "type": "string" },
    { "key": "apiVersion", "value": "api/v1", "type": "string" }
  ],
  "item": [
    {
      "name": "🏥 Health",
      "item": [
        {
          "name": "Root - API Info",
          "request": { "method": "GET", "url": "{{baseUrl}}/", "description": "Returns API name, version, environment, and links to docs." }
        },
        {
          "name": "Health Check",
          "request": { "method": "GET", "url": "{{baseUrl}}/health", "description": "Returns 200 OK if the server is running." }
        }
      ]
    },
    {
      "name": "📋 Summary",
      "item": [
        {
          "name": "Get Full Portfolio Summary",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/{{apiVersion}}/summary/",
            "description": "Single endpoint that returns the complete portfolio data in one JSON response. Use this for the frontend initial load."
          }
        }
      ]
    },
    {
      "name": "👤 Profile",
      "item": [
        {
          "name": "GET Profile",
          "request": { "method": "GET", "url": "{{baseUrl}}/{{apiVersion}}/profile/", "description": "Returns the portfolio owner's full profile." }
        },
        {
          "name": "POST Create Profile",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/{{apiVersion}}/profile/",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Wandile Nene\",\n  \"title\": \"Computer Science Graduate & AI Engineer Intern\",\n  \"tagline\": \"Building intelligent solutions at the intersection of Software Engineering and AI.\",\n  \"bio\": \"Passionate CS graduate with a focus on AI-driven software development.\",\n  \"email\": \"wandile.nene@example.com\",\n  \"phone\": \"+27 000 000 0000\",\n  \"location\": \"South Africa\",\n  \"github_url\": \"https://github.com/wandilenene\",\n  \"linkedin_url\": \"https://linkedin.com/in/wandilenene\"\n}"
            }
          }
        },
        {
          "name": "PATCH Update Profile",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/{{apiVersion}}/profile/",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Senior AI Engineer\",\n  \"tagline\": \"Updated tagline here.\"\n}"
            }
          }
        },
        {
          "name": "DELETE Profile",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/{{apiVersion}}/profile/" }
        }
      ]
    },
