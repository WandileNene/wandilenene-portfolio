    {
      "name": "📄 Resume",
      "item": [
        {
          "name": "POST Upload Resume",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/{{apiVersion}}/resume/upload",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "",
                  "description": "Select your resume PDF or DOCX file"
                },
                {
                  "key": "version",
                  "value": "v2024.08",
                  "type": "text",
                  "description": "Version label (optional)"
                },
                {
                  "key": "description",
                  "value": "Latest resume with AI Engineer experience",
                  "type": "text",
                  "description": "Description (optional)"
                }
              ]
            },
            "description": "Upload a resume file. Max 10MB. Only PDF and DOCX allowed. The new upload becomes the active resume."
          }
        },
        {
          "name": "GET Active Resume Metadata",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/{{apiVersion}}/resume/",
            "description": "Returns metadata (filename, size, version) of the currently active resume."
          }
        },
        {
          "name": "GET All Resume Versions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/{{apiVersion}}/resume/all",
            "description": "Returns metadata for all uploaded resume versions."
          }
        },
        {
          "name": "GET Download Active Resume",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/{{apiVersion}}/resume/download",
            "description": "Downloads the currently active resume file. Opens as download in browser."
          }
        },
        {
          "name": "GET Download Resume by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/{{apiVersion}}/resume/download/1",
            "description": "Downloads a specific resume version by its ID."
          }
        },
        {
          "name": "PATCH Activate Resume",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/{{apiVersion}}/resume/1/activate",
            "description": "Makes resume with ID 1 the active resume. All others become inactive."
          }
        },
        {
          "name": "DELETE Resume",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/{{apiVersion}}/resume/1",
            "description": "Deletes a resume version and its file from the server."
          }
        }
      ]
    }
