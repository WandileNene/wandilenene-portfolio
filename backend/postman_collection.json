    {
      "name": "🚀 Projects",
      "item": [
        {
          "name": "GET All Projects",
          "request": { "method": "GET", "url": "{{baseUrl}}/{{apiVersion}}/projects/" }
        },
        {
          "name": "GET Featured Projects Only",
          "request": { "method": "GET", "url": "{{baseUrl}}/{{apiVersion}}/projects/featured", "description": "Returns only projects marked as is_featured=true." }
        },
        {
          "name": "GET Filter by Status (completed)",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/{{apiVersion}}/projects/?status=completed", "query": [{ "key": "status", "value": "completed" }] } }
        },
        {
          "name": "GET Filter by Status (in-progress)",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/{{apiVersion}}/projects/?status=in-progress", "query": [{ "key": "status", "value": "in-progress" }] } }
