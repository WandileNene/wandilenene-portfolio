        },
        {
          "name": "POST Create Project",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/{{apiVersion}}/projects/",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"AI Resume Parser\",\n  \"slug\": \"ai-resume-parser\",\n  \"short_description\": \"An NLP-based tool that extracts structured data from resume PDFs.\",\n  \"description\": \"Uses spaCy and custom NER models to parse resumes into structured JSON.\",\n  \"technologies\": [\"Python\", \"spaCy\", \"FastAPI\", \"React\"],\n  \"features\": [\"PDF text extraction\", \"Named entity recognition\", \"JSON output\", \"REST API\"],\n  \"github_url\": \"https://github.com/wandilenene/ai-resume-parser\",\n  \"demo_url\": null,\n  \"status\": \"completed\",\n  \"is_featured\": false,\n  \"order\": 5\n}" }
          }
        },
        {
          "name": "PATCH Update Project",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/{{apiVersion}}/projects/1",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"is_featured\": true,\n  \"status\": \"completed\"\n}" }
          }
        },
