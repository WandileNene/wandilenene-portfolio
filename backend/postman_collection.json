            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Jane Recruiter\",\n  \"email\": \"jane.recruiter@techcorp.com\",\n  \"subject\": \"Software Engineer Role - Opportunity\",\n  \"message\": \"Hi Wandile, I came across your portfolio and I am impressed by your AI engineering background. We have an open Software Engineer role at TechCorp. Would you be interested in a chat?\"\n}" }
